# .ralph-gh.config — ralph-gh dogfooding: the loop runs on its own repo.
# Sourced from ~/.claude/ralph-gh/ralph-gh.sh

# Verification: syntax-check every shell file, then run the conductor's unit tests.
RALPH_VERIFY_COMMANDS=(
  "bash -n ralph-gh.sh"
  "bash -n install.sh"
  "python3 -m unittest discover -s tests -t ."
)

RALPH_PREFLIGHT_CMD=""
RALPH_PREFLIGHT_HEALTH_URL=""

# Docs are part of the product: orchestrator behavior changes must keep them in sync.
RALPH_DOC_FILES=("README.md" "example.ralph-gh.config")

RALPH_YOLO_ALLOWLIST=""
RALPH_BRANCH_PREFIX="feat"
RALPH_DEFAULT_BASE_BRANCH="main"
RALPH_GATE_FIX_ROUNDS=2
RALPH_SESSION_TIMEOUT=7200

# Iterations on Sonnet; review judgment stays on the Opus-pinned gate agent.
export ANTHROPIC_MODEL="claude-sonnet-5"
