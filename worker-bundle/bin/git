#!/usr/bin/env python3
"""ralph-guard execution shim for git.

Intercepts forbidden operations (`git push`, `--no-verify`) and fails closed with
informative messages before any network or hook bypass can occur.
Forwards all allowed invocations to the real git binary.
"""
import os
import shutil
import sys

GIT_PUSH_SUBCOMMANDS = frozenset({"push"})


def is_active() -> bool:
    return os.environ.get("RALPH_GUARD") == "1"


def find_real_git() -> str:
    this_dir = os.path.dirname(os.path.abspath(__file__))
    path_entries = os.environ.get("PATH", "").split(os.pathsep)
    for entry in path_entries:
        if not entry:
            continue
        try:
            entry_abs = os.path.abspath(entry)
        except Exception:
            continue
        if entry_abs == this_dir:
            continue
        candidate = os.path.join(entry, "git")
        if os.path.isfile(candidate) and os.access(candidate, os.X_OK):
            return candidate
    for fallback in ("/usr/bin/git", "/usr/local/bin/git", "/opt/homebrew/bin/git"):
        if os.path.isfile(fallback) and os.access(fallback, os.X_OK):
            return fallback
    raise FileNotFoundError("could not find real git binary in PATH")


def check_args(args: list[str]) -> str | None:
    for arg in args:
        if arg == "--no-verify" or arg.startswith("--no-verify="):
            return "--no-verify is not allowed; fix what the hooks report, then commit, or report RALPH:BLOCKED if you cannot"

    idx = 0
    while idx < len(args):
        arg = args[idx]
        if arg in ("-C", "-c", "--exec-path", "--git-dir", "--work-tree", "--namespace", "--super-prefix", "--config-env"):
            idx += 2
            continue
        if arg.startswith("-"):
            idx += 1
            continue
        if arg in GIT_PUSH_SUBCOMMANDS:
            return "only the conductor pushes; commit your work and report RALPH:DONE"
        break

    return None


def main() -> None:
    if is_active():
        reason = check_args(sys.argv[1:])
        if reason:
            sys.stderr.write(f"ralph-guard: {reason}\n")
            sys.exit(1)

    real_git = find_real_git()
    os.execv(real_git, [real_git, *sys.argv[1:]])


if __name__ == "__main__":
    main()
