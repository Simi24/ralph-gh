#!/usr/bin/env python3
"""ralph-guard execution shim for gh.

Intercepts mutating operations (PR creation/merges, issue creation/edits, api writes)
and fails closed with informative messages. Read-only queries pass to the real gh binary.
"""
import os
import sys

GH_WRITE_COMMANDS = frozenset({
    "pr", "issue", "label", "release", "repo", "workflow", "run", "secret",
    "variable", "gist", "cache", "project", "ruleset", "ssh-key", "gpg-key",
})

GH_WRITE_ACTIONS = frozenset({
    "create", "merge", "close", "reopen", "edit", "ready", "comment", "review",
    "delete", "transfer", "lock", "unlock", "pin", "unpin", "archive", "rename",
    "fork", "set", "enable", "disable", "cancel", "rerun", "clone", "run",
    "upload", "update-branch", "revert", "develop", "sync", "add", "remove",
    "link", "unlink", "copy", "mark-template", "field-create", "field-delete",
    "item-add", "item-archive", "item-create", "item-delete", "item-edit",
    "delete-asset", "deploy-key", "autolink", "unarchive",
})


def is_active() -> bool:
    return os.environ.get("RALPH_GUARD") == "1"


def find_real_gh() -> str:
    this_dir = os.path.dirname(os.path.abspath(__file__))
    path_entries = os.environ.get("PATH", "").split(os.pathsep)
    for entry in path_entries:
        if not entry:
            continue
        try:
            entry_abs = os.path.abspath(entry)
        except Exception:
            continue
        if entry_abs == this_dir:
            continue
        candidate = os.path.join(entry, "gh")
        if os.path.isfile(candidate) and os.access(candidate, os.X_OK):
            return candidate
    for fallback in ("/usr/local/bin/gh", "/opt/homebrew/bin/gh", "/usr/bin/gh"):
        if os.path.isfile(fallback) and os.access(fallback, os.X_OK):
            return fallback
    raise FileNotFoundError("could not find real gh binary in PATH")


def check_args(args: list[str]) -> str | None:
    clean: list[str] = []
    idx = 0
    while idx < len(args):
        arg = args[idx]
        if arg in ("-R", "--repo"):
            idx += 2
            continue
        if arg.startswith("--repo="):
            idx += 1
            continue
        clean.append(arg)
        idx += 1

    if not clean:
        return None

    cmd = clean[0]
    if cmd == "api":
        method = "GET"
        has_fields = False
        idx = 1
        while idx < len(clean):
            arg = clean[idx]
            if arg in ("-X", "--method") and idx + 1 < len(clean):
                method = clean[idx + 1].upper()
                idx += 2
                continue
            if arg.startswith("--method="):
                method = arg.split("=", 1)[1].upper()
                idx += 1
                continue
            if arg in ("-f", "-F", "--field", "--raw-field", "--input"):
                has_fields = True
                idx += 2
                continue
            if any(arg.startswith(prefix) for prefix in ("--field=", "--raw-field=", "--input=")):
                has_fields = True
                idx += 1
                continue
            idx += 1
        if method != "GET" or has_fields:
            return "gh api writes belong to the conductor; read-only gh calls are fine. Commit your work and report RALPH:DONE, or RALPH:BLOCKED if you need a human"
        return None

    if cmd in GH_WRITE_COMMANDS:
        for action in clean[1:]:
            if not action.startswith("-") and action in GH_WRITE_ACTIONS:
                return "GitHub writes (PRs, issues, labels, comments, merges) belong to the conductor; commit your work and report RALPH:DONE, or RALPH:BLOCKED if you need a human"

    return None


def main() -> None:
    if is_active():
        reason = check_args(sys.argv[1:])
        if reason:
            sys.stderr.write(f"ralph-guard: {reason}\n")
            sys.exit(1)

    real_gh = find_real_gh()
    os.execv(real_gh, [real_gh, *sys.argv[1:]])


if __name__ == "__main__":
    main()
