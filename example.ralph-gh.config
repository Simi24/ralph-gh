# .ralph-gh.config — per-project configuration for ralph-gh
# Sourced by ~/.claude/ralph-gh/ralph-gh.sh at startup.
# Copy this file to <repo-root>/.ralph-gh.config and fill in.

# REQUIRED: commands run in order to verify an iteration's work.
# First non-zero exit halts the iteration (classified per the failure-class rules).
RALPH_VERIFY_COMMANDS=(
  "uv run ruff check ."
  "uv run mypy src/"
  "uv run pytest tests/unit/ -x -q"
  "uv run pytest tests/integration/ -x -q"
)

# OPTIONAL: command run once per session before the loop starts (e.g. start LocalStack).
# Leave empty if no infra needed. A non-zero exit aborts the run before any
# session is spawned.
RALPH_PREFLIGHT_CMD="docker compose up -d"

# OPTIONAL: HTTP health URL polled (independently of RALPH_PREFLIGHT_CMD, once
# per second, up to RALPH_PREFLIGHT_HEALTH_RETRIES times) until 200 OK. If it
# never goes green within the retry budget, the run aborts before the loop
# starts. If non-200 during the loop instead, claude must signal SYSTEMIC_FAIL.
# Each attempt is capped at 3s to connect / 5s total, so the worst-case wait is
# about RALPH_PREFLIGHT_HEALTH_RETRIES x 6s. An endpoint that legitimately takes
# longer than 5s to answer will be misclassified as unhealthy.
# RALPH_PREFLIGHT_HEALTH_RETRIES must be a positive integer; any other value
# (0, negative, non-numeric) aborts the run at startup before any session runs.
RALPH_PREFLIGHT_HEALTH_URL="http://localhost:4566/_localstack/health"
RALPH_PREFLIGHT_HEALTH_RETRIES=30

# OPTIONAL: yolo-mode allowlist (regex applied to `gh pr diff --name-only`).
# In yolo autonomy mode, the PR auto-merges only if EVERY changed file matches.
# Leave empty to never allow yolo merges in this repo.
RALPH_YOLO_ALLOWLIST='^(src/|tests/|docs/|README\.md$|AGENTS\.md$)'

# OPTIONAL: doc files claude should consider updating on public-API changes.
RALPH_DOC_FILES=("README.md" "AGENTS.md")

# OPTIONAL: branch naming. Final branch = "<prefix>/issue-<N>-<slug>".
RALPH_BRANCH_PREFIX="ralph"

# OPTIONAL: base branch for PRs. Defaults to "main".
RALPH_DEFAULT_BASE_BRANCH="main"

# OPTIONAL: external-gate fix rounds. On a FAIL verdict the orchestrator spawns
# a fix session and re-runs the gate, at most this many times, then labels
# ralph:failed:issue. Defaults to 2.
RALPH_GATE_FIX_ROUNDS=2

# OPTIONAL: seconds before a hung claude session (iteration, gate or fix) is
# killed so an unattended run never freezes. Defaults to 7200.
RALPH_SESSION_TIMEOUT=7200

# OPTIONAL: usage-limit behavior (claude.ai subscription session/weekly quota,
# NOT API spend/credit limits). Detected best-effort from a session's own
# output -- see README's "Usage-limit awareness" section. Subscription plans
# expose no API to check remaining quota ahead of time, so this is reactive
# only: it never predicts whether a run will finish, only reacts once a
# session has already reported hitting the wall.
# 0 (default): on a hit, the issue is requeued (never failed) and the run
#   exits cleanly, recording the reset time in last-run.md.
# 1: on a hit, sleep RALPH_USAGE_WAIT_SECONDS (a bounded ceiling, not a
#   precise sleep-until-reset -- the reset time is prose, not a reliable
#   machine timestamp) and resume the loop instead of exiting.
RALPH_WAIT_FOR_RESET=0
RALPH_USAGE_WAIT_SECONDS=1800
