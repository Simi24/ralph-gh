#!/usr/bin/env python3
"""ralph-gh launcher: runs the conductor package that sits next to this file."""
import os
import sys

if sys.version_info < (3, 12):
    sys.exit("ralph-gh: needs Python 3.12 or newer (this is %d.%d)" % sys.version_info[:2])

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

from conductor.cli import main  # noqa: E402

sys.exit(main())
